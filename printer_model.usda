#usda 1.0
(
    defaultPrim = "Printer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Printer"
{
    def Scope "Looks"
    {
        def Material "body"
        {
            token outputs:surface.connect = </Printer/Looks/body/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16470589, 0.1764706, 0.1882353)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.45
                token outputs:surface
