#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "CCTV"
    {
        def Scope "Looks"
        {
            def Material "housing"
            {
                token outputs:surface.connect = </World/CCTV/Looks/housing/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.92, 0.93, 0.94)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "glass"
            {
                token outputs:surface.connect = </World/CCTV/Looks/glass/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.03, 0.03, 0.04)
                    float inputs:metallic = 0.2
                    float inputs:roughness = 0.05
                    token outputs:surface
                }
            }

            def Material "bracket"
            {
                token outputs:surface.connect = </World/CCTV/Looks/bracket/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                    float inputs:metallic = 0.6
                    float inputs:roughness = 0.4
                    token outputs:surface
                }
            }
        }

