                color3f inputs:diffuse_tint = (0.45, 0.46, 0.47)
                bool inputs:enable_ORM_texture = 1
                asset inputs:normalmap_texture = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Modular/Warehouse_A/.SubUSDs/textures/t_concrete_glossy_a_normal.png@
