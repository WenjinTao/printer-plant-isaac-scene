                asset inputs:normalmap_texture = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Modular/Warehouse_A/.SubUSDs/textures/T_Metal_CompositePanel_White_A_normal.png@
                asset inputs:ORM_texture = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Modular/Warehouse_A/.SubUSDs/textures/T_Metal_CompositePanel_White_A_orm.png@
                bool inputs:project_uvw = 1
