    over "SM_LabWorkbench_A03_01"
    {
        over "M_LabWorkbench_A01_Base" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/RealismLooks/BenchSteel> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        over "M_LabWorkbench_A01_TablePlate" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/RealismLooks/BenchWorktop> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }
