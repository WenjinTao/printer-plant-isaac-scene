class "_RealBench_station1_5" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Furnishing/Workbenches/LabWorkbench_A/LabWorkbench_A04_01.usd@
)
{
    over "Looks"
    {
        over "Metal_Glossy_A_LabWorkbench_A"
        {
            over "Shader"
            {
                custom uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                custom uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                custom color3f inputs:diffuse_color_constant = (0.42, 0.44, 0.46)
                custom float inputs:metallic_constant = 0.6
                custom float inputs:reflection_roughness_constant = 0.4
            }
        }
    }
}

class "_RealBench_table2_0" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/DigitalTwin/Assets/Warehouse/Furnishing/Workbenches/LabWorkbench_A/LabWorkbench_A03_01.usd@
)
{
    over "Looks"
    {
        over "Metal_Glossy_A_LabWorkbench_A"
        {
            over "Shader"
            {
                custom uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                custom uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                custom color3f inputs:diffuse_color_constant = (0.42, 0.44, 0.46)
                custom float inputs:metallic_constant = 0.6
                custom float inputs:reflection_roughness_constant = 0.4
            }
        }
