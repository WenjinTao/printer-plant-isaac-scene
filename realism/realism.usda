        def Material "BenchSteel"
        {
            token outputs:mdl:displacement.connect = </World/RealismLooks/BenchSteel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/RealismLooks/BenchSteel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/RealismLooks/BenchSteel/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.42, 0.44, 0.46)
