        def "Looks"
        {
            def Material "WashableWall"
            {
                token outputs:surface.connect = </World/Kitchen/Looks/WashableWall/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.88, 0.89, 0.88)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.6
