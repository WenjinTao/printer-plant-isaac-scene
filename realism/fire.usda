    def "Fire"
    {
        def "Looks"
        {
            def Material "SignExtinguisher"
            {
                token outputs:surface.connect = </World/Fire/Looks/SignExtinguisher/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </World/Fire/Looks/SignExtinguisher/tex.outputs:rgb>
                    float inputs:roughness = 0.5
                    token outputs:surface
                }

                def Shader "st"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/sign_extinguisher.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Fire/Looks/SignExtinguisher/st.outputs:result>
                    color3f outputs:rgb
                }
            }

            def Material "SignExit"
            {
                token outputs:surface.connect = </World/Fire/Looks/SignExit/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </World/Fire/Looks/SignExit/tex.outputs:rgb>
                    color3f inputs:emissiveColor.connect = </World/Fire/Looks/SignExit/tex.outputs:rgb>
                    float inputs:roughness = 0.5
                    token outputs:surface
                }

                def Shader "st"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/sign_exit.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Fire/Looks/SignExit/st.outputs:result>
                    color3f outputs:rgb
                }
            }

            def Material "PostYellow"
            {
                token outputs:surface.connect = </World/Fire/Looks/PostYellow/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.85, 0.62, 0.05)
                    float inputs:roughness = 0.45
                    token outputs:surface
                }
            }

            def Material "AlarmRed"
            {
                token outputs:surface.connect = </World/Fire/Looks/AlarmRed/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.7, 0.04, 0.04)
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }

            def Material "RouteGreen"
            {
                token outputs:surface.connect = </World/Fire/Looks/RouteGreen/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.05, 0.55, 0.25)
                    float inputs:roughness = 0.6
                    token outputs:surface
                }
            }

            def Material "DoorSteel"
            {
                token outputs:surface.connect = </World/Fire/Looks/DoorSteel/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.32, 0.35, 0.38)
                    float inputs:roughness = 0.5
                    token outputs:surface
                }
            }

            def Material "PushBar"
            {
                token outputs:surface.connect = </World/Fire/Looks/PushBar/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.75, 0.75, 0.72)
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }
        }

